@using System.Security.Claims
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HerSeyBurada</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background-color: #f5f5f5; }
        .trendyol-header { background-color: #ffffff; border-bottom: 1px solid #e6e6e6; }
        .trendyol-orange { color: #f27a1a !important; }
        .bg-trendyol { background-color: #f27a1a !important; color: #fff !important; }
        .search-input { border-radius: 6px 0 0 6px; border: 2px solid #f27a1a; background-color: #f8f8f8; }
        .search-btn { border-radius: 0 6px 6px 0; background-color: #f27a1a; color: white; border: none; }
        .category-nav { background-color: #fff; border-bottom: 1px solid #e6e6e6; }
        .category-link { color: #333; font-weight: 600; font-size: 13px; text-decoration: none; padding: 10px 14px; display: inline-block; }
        .category-link:hover { color: #f27a1a; border-bottom: 2px solid #f27a1a; }
        .user-menu-item { color: #333; text-decoration: none; font-weight: 600; font-size: 13px; display: flex; align-items: center; gap: 6px; }
        .user-menu-item:hover { color: #f27a1a; }
    </style>
</head>
<body>
    <header class="trendyol-header sticky-top shadow-sm py-2">
        <div class="container d-flex align-items-center justify-content-between gap-3">
            <a class="navbar-brand fw-bold fs-2 text-dark" href="/urun/liste">
                HerSey<span class="trendyol-orange">Burada</span>
            </a>

            <div class="flex-grow-1 mx-4 d-none d-md-flex">
                <form action="/urun/liste" method="get" class="w-100 d-flex">
                    <input type="text" name="q" class="form-control search-input py-2 px-3" placeholder="Aradığınız ürün, marka veya kategoriyi yazınız...">
                    <button class="btn search-btn px-4" type="submit"><i class="bi bi-search fs-5"></i></button>
                </form>
            </div>

            <div class="d-flex align-items-center gap-3">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    var userName = User.Identity.Name ?? "";
                    var userRole = User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value ?? User.Claims.FirstOrDefault(c => c.Type == "Rol")?.Value ?? "";
                    var isSatici = userRole == "Satici" || User.IsInRole("Satici") || userName.ToLower().Contains("firma") || userName.ToLower().Contains("satici");
                    var isAdmin = userRole == "Admin" || User.IsInRole("Admin") || userName == "hamzacana98@gmail.com";

                    <div class="dropdown">
                        <a href="#" class="user-menu-item dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi @(isSatici ? "bi-shop text-primary" : isAdmin ? "bi-shield-check text-danger" : "bi-person-circle trendyol-orange") fs-4"></i>
                            <div>
                                <span class="d-block text-muted small" style="font-size:10px;">Hesabım</span>
                                <span class="fw-bold">@userName</span>
                            </div>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2 rounded-3">
                            @if (isSatici)
                            {
                                <li><a class="dropdown-item fw-semibold py-2 text-primary" href="/satici/urunler"><i class="bi bi-box-seam me-2"></i> Mağaza Ürün Panelim</a></li>
                                <li><a class="dropdown-item fw-semibold py-2 text-success" href="/satici/urun-ekle"><i class="bi bi-plus-circle me-2"></i> Yeni Ürün Ekle</a></li>
                                <li><a class="dropdown-item fw-semibold py-2" href="/kullanici/profil"><i class="bi bi-person-gear me-2"></i> Mağaza Bilgilerim</a></li>
                            }
                            else if (isAdmin)
                            {
                                <li><a class="dropdown-item fw-semibold py-2 text-danger" href="/admin/basvurular"><i class="bi bi-shield-check me-2"></i> Admin Onay Paneli</a></li>
                                <li><a class="dropdown-item fw-semibold py-2" href="/kullanici/profil"><i class="bi bi-person-gear me-2"></i> Profil Bilgilerim</a></li>
                            }
                            else
                            {
                                <li><a class="dropdown-item fw-semibold py-2" href="/kullanici/profil"><i class="bi bi-person-gear me-2 text-primary"></i> Bilgilerimi Güncelle</a></li>
                                <li><a class="dropdown-item fw-semibold py-2" href="/siparis/listem"><i class="bi bi-bag-check me-2 text-success"></i> Satın Aldıklarım</a></li>
                                <li><a class="dropdown-item fw-semibold py-2" href="/favori/liste"><i class="bi bi-heart me-2 text-danger"></i> Favorilerim</a></li>
                            }
                            <li><hr class="dropdown-divider my-1"></li>
                            <li><a class="dropdown-item text-danger fw-bold py-2" href="/security/cikis"><i class="bi bi-box-arrow-right me-2"></i> Çıkış Yap</a></li>
                        </ul>
                    </div>

                    @if (!isSatici && !isAdmin)
                    {
                        <a href="/favori/liste" class="user-menu-item ms-1">
                            <i class="bi bi-heart fs-4 text-danger"></i>
                            <span class="d-none d-md-inline">Favorilerim</span>
                        </a>
                        <a href="/siparis/sepet" class="user-menu-item position-relative ms-1">
                            <i class="bi bi-cart3 fs-3 text-success"></i>
                            <span class="d-none d-md-inline">Sepetim</span>
                        </a>
                    }
                }
                else
                {
                    <a href="/security/girisyap" class="user-menu-item">
                        <i class="bi bi-person fs-4 trendyol-orange"></i>
                        <div>
                            <span class="d-block text-muted small" style="font-size:10px;">Giriş Yap</span>
                            <span>Hesabım</span>
                        </div>
                    </a>

                    <a href="/security/kayitol" class="btn btn-outline-warning text-dark fw-bold btn-sm rounded-3 px-3">
                        <i class="bi bi-person-plus me-1"></i> Kayıt Ol
                    </a>
                }
            </div>
        </div>

        <!-- TEK VE ŞIK KATEGORİ NAVBAR -->
        <nav class="category-nav mt-2 d-none d-md-block">
            <div class="container d-flex justify-content-center gap-4 overflow-auto">
                <a href="/urun/liste?kategori=Tümü" class="category-link">TÜM ÜRÜNLER</a>
                <a href="/urun/liste?kategori=Giyim" class="category-link">GİYİM</a>
                <a href="/urun/liste?kategori=Ayakkabı" class="category-link">AYAKKABI</a>
                <a href="/urun/liste?kategori=Elektronik" class="category-link">ELEKTRONİK</a>
                <a href="/urun/liste?kategori=Ev %26 Yaşam" class="category-link">EV & YAŞAM</a>
            </div>
        </nav>
    </header>

    <main class="container my-4">
        @RenderBody()
    </main>

    <footer class="bg-dark text-white text-center py-4 mt-5">
        <div class="container">
            <p class="mb-0">&copy; 2026 HerSeyBurada Pazaryeri Platformu. Tüm Hakları Saklıdır.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>