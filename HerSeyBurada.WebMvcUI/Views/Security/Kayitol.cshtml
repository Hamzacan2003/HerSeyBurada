@{
    ViewData["Title"] = "Kayıt Ol - HerSeyBurada";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center my-4">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-sm p-4 rounded-4 bg-white">
            <h3 class="fw-bold text-center mb-4 text-dark">HerSeyBurada'ya Kayıt Ol</h3>

            @if (ViewBag.Hata != null)
            {
                <div class="alert alert-danger font-semibold">@ViewBag.Hata</div>
            }
            @if (TempData["Hata"] != null)
            {
                <div class="alert alert-danger font-semibold">@TempData["Hata"]</div>
            }

            <form asp-controller="Security" asp-action="KayitOl" method="post">
                <!-- Üyelik Tipi Seçimi -->
                <div class="mb-4">
                    <label class="form-label fw-bold d-block">Hesap Türünü Seçiniz</label>
                    <div class="btn-group w-100" role="group">
                        <input type="radio" class="btn-check" name="Rol" id="rolMusteri" value="Musteri" checked onchange="toggleRolFields()">
                        <label class="btn btn-outline-warning text-dark fw-bold py-2" for="rolMusteri"><i class="bi bi-person me-1"></i> Müşteri (Alıcı)</label>

                        <input type="radio" class="btn-check" name="Rol" id="rolSatici" value="Satici" onchange="toggleRolFields()">
                        <label class="btn btn-outline-primary fw-bold py-2" for="rolSatici"><i class="bi bi-shop me-1"></i> Firma (Satıcı)</label>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold" id="lblAd">Ad</label>
                        <input type="text" name="Ad" class="form-control" required placeholder="Adınız" />
                    </div>
                    <div class="col-md-6 mb-3" id="divSoyad">
                        <label class="form-label fw-semibold">Soyad</label>
                        <input type="text" name="Soyad" class="form-control" placeholder="Soyadınız" />
                    </div>
                </div>

                <!-- Firma Alanları -->
                <div id="firmaAlanlari" style="display:none;">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mağaza / Firma Ticari Adı</label>
                        <input type="text" id="inputMagazaAdi" name="MagazaAdi" class="form-control" placeholder="Örn: ABC Teknoloji Ltd." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Vergi Numarası / TC No</label>
                        <input type="text" id="inputVergiNo" name="VergiNo" class="form-control" placeholder="10 Haneli Vergi No" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">E-Posta Adresi</label>
                    <input type="email" name="Eposta" class="form-control" required placeholder="ornek@email.com" />
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">Şifre</label>
                    <input type="password" name="Sifre" class="form-control" required placeholder="******" />
                </div>

                <button type="submit" class="btn bg-trendyol w-100 fw-bold btn-lg shadow-sm">KAYIT OL</button>
            </form>

            <div class="text-center mt-4">
                <span class="text-muted">Zaten hesabınız var mı?</span>
                <a href="/security/girisyap" class="fw-bold trendyol-orange text-decoration-none ms-1">Giriş Yap</a>
            </div>
        </div>
    </div>
</div>

<script>
    function toggleRolFields() {
        var isSatici = document.getElementById('rolSatici').checked;
        var firmaAlanlari = document.getElementById('firmaAlanlari');
        var lblAd = document.getElementById('lblAd');
        var inputMagaza = document.getElementById('inputMagazaAdi');
        var inputVergi = document.getElementById('inputVergiNo');

        if (isSatici) {
            firmaAlanlari.style.display = 'block';
            lblAd.innerText = 'Yetkili Adı';
            inputMagaza.setAttribute('required', 'required');
            inputVergi.setAttribute('required', 'required');
        } else {
            firmaAlanlari.style.display = 'none';
            lblAd.innerText = 'Ad';
            inputMagaza.removeAttribute('required');
            inputVergi.removeAttribute('required');
        }
    }
</script>