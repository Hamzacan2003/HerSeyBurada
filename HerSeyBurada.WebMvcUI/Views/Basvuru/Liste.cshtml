@model IEnumerable<HerSeyBurada.Core.Entities.Urun>

@{
    ViewData["Title"] = "Ürün Listesi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-4">
    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                // Entity içerisindeki Property isimlerine dinamik fallback tanımlıyoruz
                var urunId = item.GetType().GetProperty("Id")?.GetValue(item, null) ?? Guid.Empty;
                var urunAdi = item.GetType().GetProperty("UrunAdi")?.GetValue(item, null) 
                            ?? item.GetType().GetProperty("Ad")?.GetValue(item, null) 
                            ?? item.GetType().GetProperty("Name")?.GetValue(item, null) 
                            ?? "Ürün";

                var kategori = item.GetType().GetProperty("Kategori")?.GetValue(item, null) 
                             ?? item.GetType().GetProperty("KategoriAdi")?.GetValue(item, null) 
                             ?? "Genel";

                var fiyat = item.GetType().GetProperty("Fiyat")?.GetValue(item, null) 
                          ?? item.GetType().GetProperty("Price")?.GetValue(item, null) 
                          ?? 0m;

                var resimUrl = item.GetType().GetProperty("ResimUrl")?.GetValue(item, null)?.ToString() 
                            ?? item.GetType().GetProperty("GorselUrl")?.GetValue(item, null)?.ToString() 
                            ?? "https://via.placeholder.com/300x300?text=Urun+Resmi";

                <div class="col-md-4">
                    <div class="card h-100 shadow-sm border-0 rounded-4 p-2">
                        <img src="@resimUrl" class="card-img-top rounded-3" style="height: 220px; object-fit: cover;" />
                        <div class="card-body d-flex flex-column justify-content-between">
                            <div>
                                <span class="badge bg-light text-primary mb-2 fw-bold">@kategori</span>
                                <h6 class="card-title fw-bold text-dark">@urunAdi</h6>
                            </div>
                            <div class="mt-3">
                                <p class="text-danger fw-bold fs-4 mb-2">@Convert.ToDecimal(fiyat).ToString("N2") TL</p>
                                <div class="d-grid gap-2">
                                    <button class="btn btn-warning text-white fw-bold btn-sepete-ekle" data-id="@urunId">
                                        <i class="bi bi-cart-plus me-1"></i> SEPETE EKLE
                                    </button>
                                    <button class="btn btn-outline-danger btn-sm fw-bold btn-favori-ekle" data-id="@urunId">
                                        <i class="bi bi-heart me-1"></i> FAVORİLERE EKLE
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <div class="card p-5 border-0 shadow-sm rounded-4">
                    <i class="bi bi-box-seam display-1 text-muted mb-3"></i>
                    <h4 class="fw-bold text-secondary">Henüz Eklenmiş Gerçek Ürün Bulunamadı</h4>
                    <p class="text-muted">Satıcı paneline giriş yaparak yeni ürün eklediğinizde ürünler burada otomatik listelenecektir.</p>
                    <div>
                        <a href="/satici/urun-ekle" class="btn btn-primary fw-bold px-4">
                            <i class="bi bi-plus-circle me-1"></i> Satıcı Ürün Ekle Sayfasına Git
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>