@{
    ViewData["Title"] = "Favorilerim - HerSeyBurada";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-4">
    <h4 class="fw-bold mb-4"><i class="bi bi-heart-fill text-danger me-2"></i> Favorilerim</h4>

    <div class="row row-cols-1 row-cols-md-4 g-4" id="favoriContainer">
        <!-- Dinamik JS ile yüklenecek -->
    </div>
    
    <div id="favoriBosUyari" class="text-center py-5 d-none">
        <i class="bi bi-heartbreak fs-1 text-muted d-block mb-3"></i>
        <h5 class="fw-bold text-muted">Favorilerinizde henüz ürün bulunmuyor.</h5>
        <a href="/urun/liste" class="btn btn-warning text-white fw-bold mt-2">Alışverişe Başla</a>
    </div>
</div>

<script>
    $(document).ready(function() {
        favorileriListele();
    });

    function favorileriListele() {
        let favoriler = JSON.parse(localStorage.getItem('favoriListesi')) || [];
        let container = $('#favoriContainer');
        container.empty();

        if (favoriler.length === 0) {
            $('#favoriBosUyari').removeClass('d-none');
            return;
        } else {
            $('#favoriBosUyari').addClass('d-none');
        }

        favoriler.forEach(function(item) {
            let cardHtml = `
                <div class="col" id="fav-item-${item.id}">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden position-relative product-card" onclick="location.href='/urun/detay/${item.id}'">
                        <button type="button" class="btn btn-light btn-sm rounded-circle position-absolute top-0 end-0 m-2 shadow-sm z-3" onclick="event.stopPropagation(); favoridenCikar(${item.id});">
                            <i class="bi bi-x-lg text-danger"></i>
                        </button>
                        <img src="${item.resim}" class="card-img-top" style="height:220px; object-fit:cover;" alt="${item.ad}" />
                        <div class="card-body d-flex flex-column justify-content-between">
                            <div>
                                <span class="badge bg-light text-dark mb-1 fw-bold">${item.marka}</span>
                                <h6 class="card-title fw-bold text-dark text-truncate">${item.ad}</h6>
                                <div class="text-danger fw-bold fs-5">${item.fiyat} TL</div>
                            </div>
                            <button class="btn btn-warning w-100 fw-bold text-white mt-3" onclick="event.stopPropagation(); sepeteEkleDinamik('${item.ad}');">
                                SEPETE EKLE
                            </button>
                        </div>
                    </div>
                </div>`;
            container.append(cardHtml);
        });
    }

    function favoridenCikar(id) {
        let favoriler = JSON.parse(localStorage.getItem('favoriListesi')) || [];
        favoriler = favoriler.filter(x => x.id !== id);
        localStorage.setItem('favoriListesi', JSON.stringify(favoriler));
        
        $('.fav-count').text(favoriler.length);
        favorileriListele();
    }
</script>