@model HerSeyBurada.Core.Entities.Kullanici

@{
    ViewData["Title"] = "Profil Bilgilerim";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5" style="max-width: 650px;">
    <div class="card border-0 shadow-lg rounded-4 p-4 bg-white">
        <h4 class="fw-bold text-primary mb-4"><i class="bi bi-person-gear me-2"></i> Profil Bilgilerimi Güncelle</h4>

        @if (TempData["Mesaj"] != null)
        {
            <div class="alert alert-success fw-bold">@TempData["Mesaj"]</div>
        }
        @if (TempData["Hata"] != null)
        {
            <div class="alert alert-danger fw-bold">@TempData["Hata"]</div>
        }

        <form action="/kullanici/profil-guncelle" method="post">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold">Ad / Mağaza Yetkili Adı</label>
                    <input type="text" name="Ad" value="@Model.Ad" class="form-control py-2" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">Soyad</label>
                    <input type="text" name="Soyad" value="@Model.Soyad" class="form-control py-2" required />
                </div>
                <div class="col-12">
                    <label class="form-label fw-bold">E-Posta Adresi</label>
                    <input type="email" value="@Model.Eposta" class="form-control py-2 bg-light" readonly />
                </div>

                <hr class="my-4" />
                <h6 class="fw-bold text-secondary">Şifre Değiştirme (İsteğe Bağlı)</h6>

                <div class="col-md-4">
                    <label class="form-label fw-bold">Mevcut Şifre</label>
                    <input type="password" name="MevcutSifre" class="form-control py-2" placeholder="******" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Yeni Şifre</label>
                    <input type="password" name="YeniSifre" class="form-control py-2" placeholder="******" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Yeni Şifre (Tekrar)</label>
                    <input type="password" name="YeniSifreTekrar" class="form-control py-2" placeholder="******" />
                </div>

                <div class="col-12 mt-4">
                    <button type="submit" class="btn btn-warning text-white fw-bold w-100 py-3 rounded-3">
                        BİLGİLERİ VE ŞİFREYİ KAYDET
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>