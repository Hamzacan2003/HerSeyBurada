@{
    ViewData["Title"] = "Mağaza Yönetim Paneli";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold"><i class="bi bi-speedometer2 text-primary"></i> Mağaza Ürün & Stok Yönetimi</h3>
        <a href="/satici/urunekle" class="btn btn-success fw-bold"><i class="bi bi-plus-circle"></i> Yeni Ürün Ekle</a>
    </div>

    @if (TempData["Mesaj"] != null)
    {
        <div class="alert alert-success fw-bold">@TempData["Mesaj"]</div>
    }

    <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Görsel</th>
                    <th>Ürün Adı</th>
                    <th>Fiyat</th>
                    <th>Stok (M/L/42)</th>
                    <th>Durum</th>
                    <th>İşlem</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><img src="https://images.unsplash.com/photo-1521572267360-ee0c2909d518?w=100&q=80" style="width:50px; height:50px; object-fit:cover;" class="rounded-3" /></td>
                    <td class="fw-bold">Erkek Siyah Oversize Logo Tişört</td>
                    <td class="text-danger fw-bold">719,90 TL</td>
                    <td><span class="badge bg-info text-dark">47 Adet</span></td>
                    <td><span class="badge bg-success">Satışta</span></td>
                    <td><a href="/satici/urunekle" class="btn btn-sm btn-outline-primary fw-bold">Düzenle</a></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>